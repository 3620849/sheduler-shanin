# =============================================================================
# Root .gitignore for Distributed Task Scheduling Platform
# =============================================================================

# -----------------------------------------------------------------------------
# Operating System Files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# -----------------------------------------------------------------------------
# IDEs & Developer Tools
# -----------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# Eclipse
.project
.classpath
.settings/
.factorypath
bin/

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# Other editor swap/backup files
*.swp
*.swo
*~
*.bak

# -----------------------------------------------------------------------------
# Java & Backend Build Artifacts (Maven / Gradle)
# -----------------------------------------------------------------------------
target/
**/target/
*.class

# Maven
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildSuccess
pom.xml.cache*
.mvn/timing.properties

# Gradle
.gradle/
build/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# -----------------------------------------------------------------------------
# Node.js & Frontend Build Artifacts (React / Vite)
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
dist-ssr/
.vite/
.cache/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# Environment & Secret Files
# -----------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# -----------------------------------------------------------------------------
# Testing & Code Coverage
# -----------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# -----------------------------------------------------------------------------
# Logs & Databases
# -----------------------------------------------------------------------------
*.log
logs/
*.pid
*.seed
*.pid.lock

# Embedded / Local DB files
*.sqlite
*.sqlite-journal
*.sqlite3

# -----------------------------------------------------------------------------
# Docker & Local Overrides
# -----------------------------------------------------------------------------
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml

# -----------------------------------------------------------------------------
# Temporary Files & AI Agent Caches
# -----------------------------------------------------------------------------
tmp/
temp/
.temp/
.gemini/
